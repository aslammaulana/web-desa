# SUPABASE CONFIGURATION
# Salin file ini menjadi .env.local dan isi nilainya dari Dashboard Supabase Anda:
# Project Settings -> API -> Project URL & Project API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Opsional: Service role key untuk operasional backend admin (jika dibutuhkan)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
